{
  "manifest_version": 3,
  "name": "PiP the Player",
  "short_name": "PiPtP",
  "version": "0.6.5",
  "description": "Moves a site's whole video player into a Picture-in-Picture window, with its controls and subtitles.",
  "permissions": ["scripting", "activeTab", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "PiP the Player" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+P" },
      "description": "Toggle Picture-in-Picture for the player"
    }
  }
}
