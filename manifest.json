{
  "manifest_version": 3,
  "name": "PiP with Subtitles",
  "version": "0.2.1",
  "description": "Picture-in-Picture that keeps the site's own subtitles (moves the whole player into a Document PiP window).",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "PiP with subtitles" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+P" },
      "description": "Toggle Picture-in-Picture with subtitles"
    }
  }
}
